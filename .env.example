# Truv sandbox or production credentials (from the Truv dashboard)
TRUV_CLIENT_ID=
TRUV_SECRET=

# Optional. Sandbox or production is decided by the keys, not the URL.
# TRUV_BASE_URL=https://prod.truv.com/v1

# Optional. Name of the fictional bank shown in the pages.
# BANK_NAME=Cedar & Stone Bank

# Optional. Site login (HTTP Basic Auth). When both are set, every page except
# /webhooks/truv and /health asks for this user name and password.
# DEMO_USER=
# DEMO_PASSWORD=

# Optional. Storage backend: file (default, local and Render) or dynamodb (AWS Lambda).
# STORE_BACKEND=file
# DYNAMODB_TABLE=

# Optional. Set to 0 to stop saving Truv payloads to samples/ (read-only disks).
# SAVE_SAMPLES=1
